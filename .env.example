# Neo4j connection
NEO4J_URI=neo4j://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-secret

# Docker Compose image pinned to the version verified in stage 4.
NEO4J_IMAGE=neo4j:2026.06.0-community

# Text-to-Cypher LLM (not required for --provider gold)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenAI 키가 없을 때 자동 선택되는 Vertex AI Gemini
# 인증 JSON은 저장소 밖에 두고 절대 커밋하지 않는다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.5-flash

# FastAPI product boundary
P3_API_PROVIDER=auto
P3_API_MODEL=
P3_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Streamlit 승인 적재는 기본 비활성화한다.
P3_ENABLE_UI_LOAD=0
# macOS Homebrew 개발환경: homebrew, 쓰기 가능한 서버/컨테이너: none
P3_NEO4J_MODE_CONTROL=homebrew
