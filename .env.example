# Neo4j connection
NEO4J_URI=neo4j://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-secret
# 운영 환경에서는 적재 전용 계정을 별도로 주입할 수 있다. 미설정 시
# 표준 계정을 사용하되 조회 경로는 Neo4j READ 세션으로 계속 제한된다.
NEO4J_LOADER_USERNAME=
NEO4J_LOADER_PASSWORD=

# Docker Compose image pinned to the version verified in stage 4.
NEO4J_IMAGE=neo4j:2026.06.0-community

# Text-to-Cypher LLM (not required for --provider gold)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenAI 키가 없을 때 자동 선택되는 Vertex AI Gemini
# 인증 JSON은 저장소 밖에 두고 절대 커밋하지 않는다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.5-flash

# FastAPI product boundary
P3_API_PROVIDER=auto
P3_API_MODEL=
P3_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 같은 네트워크 공유 시 scripts/run_lan.sh가 자동 감지한다.
# 자동 감지가 잘못된 환경에서만 192.168.x.x 형태로 지정한다.
P3_LAN_IP=
P3_STREAMLIT_PORT=8501

# UI 노출 프로필: production, demo, development
# production/demo에서는 provider·Gold 회귀·역할 시뮬레이션·개발 단계 표시를 숨긴다.
P3_UI_MODE=demo
# 인증 연결 전 고정 내부 콘솔 역할. development에서는 역할 미리보기가 우선한다.
P3_UI_ROLE=Data Steward

# Streamlit 승인 적재는 기본 비활성화한다.
P3_ENABLE_UI_LOAD=0
# macOS Homebrew 개발환경: homebrew, 쓰기 가능한 서버/컨테이너: none
P3_NEO4J_MODE_CONTROL=homebrew
# Homebrew Neo4j 종료·기동 시간을 포함한 연결 대기 상한
P3_NEO4J_RESTART_TIMEOUT_SECONDS=90
